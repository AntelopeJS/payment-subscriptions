{
  "name": "@antelopejs/payment-subscriptions",
  "version": "0.0.3",
  "description": "Generic AntelopeJS subscriptions on top of any payment interface provider: saved methods charged off-session, on a renewal clock the module owns",
  "keywords": [
    "antelopejs",
    "billing",
    "payment",
    "recurring",
    "subscription"
  ],
  "homepage": "https://github.com/AntelopeJS/payment-subscriptions/tree/main/docs",
  "bugs": {
    "url": "https://github.com/AntelopeJS/payment-subscriptions/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/payment-subscriptions.git"
  },
  "files": [
    "dist",
    "!dist/test",
    "docs",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && pnpm run test:polling && pnpm run test:redis",
    "test:polling": "ajs module test .",
    "test:redis": "ANTELOPE_SUBSCRIPTIONS_TEST_CLOCK=redis ajs module test .",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-database": ">=0.2.0 <1.0.0",
    "@antelopejs/interface-payment": ">=0.0.2 <1.0.0",
    "@antelopejs/interface-subscriptions": ">=0.1.0 <0.2.0"
  },
  "devDependencies": {
    "@antelopejs/core": "1.16.0",
    "@antelopejs/mongodb": "^1.6.0",
    "@antelopejs/redis": "^1.0.3",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb-memory-server-core": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "redis-memory-server": "^0.17.1",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-redis": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-redis-scheduler": ">=0.0.9 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-subscriptions"
    ],
    "defaultConfig": {},
    "test": "src/test/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
